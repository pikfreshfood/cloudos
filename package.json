{
  "name": "cloud-os",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "set EXPO_NO_DEPENDENCY_VALIDATION=1&& expo start --host lan --clear",
    "start:dev": "set EXPO_NO_DEPENDENCY_VALIDATION=1&& expo start --host lan --dev-client --clear",
    "android": "set EXPO_NO_DEPENDENCY_VALIDATION=1&& expo start --host lan --android --clear",
    "android:dev": "set EXPO_NO_DEPENDENCY_VALIDATION=1&& expo run:android",
    "ios": "set EXPO_NO_DEPENDENCY_VALIDATION=1&& expo start --host lan --ios --clear",
    "web": "set EXPO_NO_DEPENDENCY_VALIDATION=1&& expo start --web --clear",
    "build:android:dev": "npx eas build --profile development --platform android",
    "build:android:preview": "npx eas build --profile preview --platform android --clear-cache"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-community/slider": "5.0.1",
    "@react-navigation/bottom-tabs": "^7.15.9",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.11",
    "axios": "^1.15.0",
    "expo": "~54.0.34",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-auth-session": "~7.0.11",
    "expo-background-fetch": "~14.0.9",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.22",
    "expo-font": "~14.0.11",
    "expo-intent-launcher": "~13.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-navigation-bar": "~5.0.10",
    "expo-notifications": "~0.32.17",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-task-manager": "~14.0.9",
    "expo-updates": "~29.0.17",
    "expo-video": "~3.0.16",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "^13.15.0"
  },
  "private": true
}
